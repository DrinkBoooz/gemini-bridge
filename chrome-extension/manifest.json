{
  "manifest_version": 3,
  "name": "Gemini Bridge - Universal Webchat Agent Bridge",
  "version": "1.0.0",
  "description": "Bi-directional WebSocket harness bridge for Gemini, ChatGPT, and Claude web sessions",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
